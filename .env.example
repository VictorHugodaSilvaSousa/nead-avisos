# NEAD Avisos — configuração (sem senhas; os segredos ficam no Gerenciador de Credenciais)
NEAD_AVISOS_BASE_URL=https://nead.ifb.edu.br
# O usuário do Moodle NÃO precisa ficar aqui: o setup pergunta uma vez e não grava (no NEAD ele é o CPF).
NEAD_AVISOS_TIMEZONE=America/Sao_Paulo
# Seu chat privado (recebe tudo) e o grupo da turma (só avisos gerais). Descubra com: nead-avisos chats
# NEAD_AVISOS_TELEGRAM_CHAT_ID=
# NEAD_AVISOS_TELEGRAM_GROUP_ID=
# Lembretes de prazo: quantos dias antes (0 = no dia)
NEAD_AVISOS_LEMBRETES_DIAS=3,1,0
# Resumo diário dos prazos da semana a partir desta hora
NEAD_AVISOS_RESUMO_HORA=7
# Horário sem som (urgentes tocam); 0 desliga
NEAD_AVISOS_SILENCIO=22-7
# NEAD_AVISOS_INCLUIR_SALAS=   (ids separados por vírgula)
# NEAD_AVISOS_EXCLUIR_SALAS=
# NEAD_AVISOS_SALAS_DO_GRUPO=  (vazio = as mesmas salas acompanhadas)
